    "@storybook/testing-library": "0.2.2",
    "@types/chrome": "0.1.24",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "bestzip": "2.2.1",
    "eslint": "9.37.0",
    "standard-version": "9.5.0",
